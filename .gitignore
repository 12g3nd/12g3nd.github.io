# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Brainstorm visual-companion artifacts
.superpowers/

# Private blog planning (not for publishing)
BLOG_ROADMAP.md

# Transmission drafts and full-res source photos, kept locally only. The
# published copies are the ones that ship: src/content/*.mdx and public/blogN/,
# where the photos are resized to web weight. Root .md/images are always
# working files here — README is the one exception.
/*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md
/*.png
/*.jpg
/*.jpeg
# The one root image that is not a working file: the README's wordmark.
!/ascii-art-text.png

# Playwright MCP output
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Visual-regression harness: screenshot baselines, and the cached guestbook
# fixture (44 real signatures, fetched from the Worker on first run). Both are
# local working state that must not vary with the repo. See scripts/visual.mjs.
scripts/visual/
scripts/fixtures/

# Per-machine Claude Code settings. Ignored by this repo rather than only by a
# global gitignore, so a fresh clone on another machine does not commit them.
**/.claude/settings.local.json
